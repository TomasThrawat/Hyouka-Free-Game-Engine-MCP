{
  "version": "1.5.2",
  "providers": [
    {
      "id": "assetmcp-vercel",
      "name": "ASSETMCP",
      "description": "Remote free asset MCP for Kenney, Poly Haven, ambientCG, OpenGameArt, Openverse, itch.io, Godot Asset Library and related asset sources.",
      "url": "https://assetmcp-vercel-http.vercel.app/api/mcp",
      "urlEnv": "HYOUKA_ASSETMCP_URL",
      "enabled": true,
      "source": "https://github.com/TomasThrawat/ASSETMCP-Vercel-HTTP",
      "license": "MIT",
      "capabilities": [
        "kenney",
        "polyhaven",
        "ambientcg",
        "opengameart",
        "openverse",
        "itch",
        "godot-asset-library",
        "license-audit",
        "asset-download"
      ],
      "dynamicDiscovery": true,
      "discoveryProtocol": "MCP tools/list"
    },
    {
      "id": "blender-mcp",
      "name": "Blender MCP",
      "description": "Remote Blender MCP over Streamable HTTP. The unified Godot MCP discovers its tools dynamically from the configured remote endpoint.",
      "authType": "vercel-oidc",
      "enabled": true,
      "source": "https://github.com/dcc-mcp/dcc-mcp-blender",
      "license": "MIT",
      "capabilities": [
        "scene-management",
        "objects",
        "mesh",
        "uv",
        "rigging",
        "animation",
        "materials",
        "shader-nodes",
        "rendering",
        "physics",
        "compositing",
        "glb-export"
      ],
      "dynamicDiscovery": true,
      "discoveryProtocol": "MCP tools/list",
      "urlFile": "https://raw.githubusercontent.com/TomasThrawat/Hyouka-DCC-Remote-MCP/main/runtime/blender-endpoint.json",
      "urlFileKey": "url"
    },
    {
      "id": "krita-mcp",
      "name": "Krita MCP",
      "description": "Remote Krita MCP over Streamable HTTP. The unified Godot MCP discovers its tools dynamically from the configured remote endpoint.",
      "authType": "vercel-oidc",
      "enabled": true,
      "source": "https://github.com/dcc-mcp/dcc-mcp-krita",
      "license": "MIT",
      "capabilities": [
        "canvas",
        "layers",
        "painting",
        "shapes",
        "filters",
        "export",
        "texture-source-art"
      ],
      "dynamicDiscovery": true,
      "discoveryProtocol": "MCP tools/list",
      "urlFile": "https://raw.githubusercontent.com/TomasThrawat/Hyouka-DCC-Remote-MCP/main/runtime/krita-endpoint.json",
      "urlFileKey": "url"
    },
    {
      "id": "godot-live-180",
      "name": "Godot Live Control 180",
      "description": "Disabled duplicate remote Godot provider because the unified gateway exposes the native Godot bridge directly.",
      "enabled": false,
      "source": "https://github.com/Fulviuus/godot-mcp",
      "capabilities": [
        "project-inspection",
        "scene-parsing",
        "script-validation",
        "build",
        "export",
        "live-run",
        "live-scene-tree",
        "live-eval",
        "hot-reload",
        "screenshots",
        "runtime-input",
        "deep-editor-control"
      ],
      "dynamicDiscovery": true,
      "discoveryProtocol": "MCP tools/list",
      "authType": "vercel-oidc",
      "urlFile": "https://raw.githubusercontent.com/TomasThrawat/Hyouka-Free-Game-Engine-MCP/main/runtime/godot-full-control-bridge.json",
      "urlFileKey": "url",
      "license": "MIT"
    },
    {
      "id": "sfxmint",
      "name": "SFXMint",
      "description": "Public MCP for searchable and hotlinkable CC0 sound effects.",
      "url": "https://sfxmint.com/mcp",
      "enabled": true,
      "source": "https://github.com/flreey/sfxmint-mcp",
      "capabilities": [
        "sound-effects",
        "foley",
        "ui-sounds",
        "search",
        "cc0-audio"
      ],
      "dynamicDiscovery": true,
      "discoveryProtocol": "MCP tools/list"
    },
    {
      "id": "sfx-gen-local",
      "name": "SFX Generator Local",
      "description": "Optional local Streamable HTTP SFX generator using Stable Audio Open for offline/local production.",
      "urlEnv": "HYOUKA_SFX_MCP_URL",
      "enabled": true,
      "source": "https://github.com/JimCline/sfx-gen-mcp",
      "license": "MIT",
      "capabilities": [
        "sound-effects",
        "foley",
        "ambience",
        "variation-generation",
        "local-audio"
      ],
      "dynamicDiscovery": true,
      "discoveryProtocol": "MCP tools/list"
    }
  ]
}
