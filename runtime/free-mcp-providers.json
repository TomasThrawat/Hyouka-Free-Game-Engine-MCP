{
  "version": "1.1.4",
  "providers": [
    {
      "id": "assetmcp-vercel",
      "name": "ASSETMCP",
      "description": "Remote free asset MCP for Kenney, Poly Haven, ambientCG, OpenGameArt, Openverse, itch.io, Godot Asset Library and related asset sources.",
      "url": "https://assetmcp-vercel-http.vercel.app/api/mcp",
      "urlEnv": "HYOUKA_ASSETMCP_URL",
      "enabled": true,
      "source": "https://github.com/TomasThrawat/ASSETMCP-Vercel-HTTP",
      "license": "MIT",
      "capabilities": [
        "kenney",
        "polyhaven",
        "ambientcg",
        "opengameart",
        "openverse",
        "itch",
        "godot-asset-library",
        "license-audit",
        "asset-download"
      ]
    },
    {
      "id": "blender-dcc",
      "name": "DCC-MCP Blender",
      "description": "Typed Blender automation over Streamable HTTP. The explicit MCP URL has priority, while the existing Hyouka Blender bridge is a fallback.",
      "urlEnv": "HYOUKA_BLENDER_MCP_URL",
      "urlEnvFallback": "BLENDER_BRIDGE_URL",
      "urlSuffix": "/mcp",
      "enabled": true,
      "source": "https://github.com/dcc-mcp/dcc-mcp-blender",
      "license": "MIT",
      "capabilities": [
        "modeling",
        "mesh-editing",
        "uv",
        "rigging",
        "animation",
        "materials",
        "shader-nodes",
        "texture-pipeline",
        "scene-editing",
        "physics",
        "rendering",
        "compositing",
        "validation",
        "glb-export"
      ]
    },
    {
      "id": "krita",
      "name": "Krita MCP",
      "description": "Krita painting and raster-art automation over an MCP server connected to the running Krita plugin.",
      "urlEnv": "HYOUKA_KRITA_MCP_URL",
      "tokenEnv": "HYOUKA_KRITA_MCP_TOKEN",
      "enabled": true,
      "source": "https://github.com/edithatogo/krita-cli",
      "capabilities": [
        "canvas",
        "layers",
        "painting",
        "shapes",
        "filters",
        "export",
        "texture-source-art"
      ]
    },
    {
      "id": "godot-full-control-157",
      "name": "Godot Full Control 157",
      "description": "High-coverage Godot 4 MCP implementation with deep scene, runtime, rendering, audio, animation and physics controls.",
      "urlEnv": "HYOUKA_GODOT_FULL_MCP_URL",
      "enabled": true,
      "source": "https://github.com/tugcantopaloglu/godot-mcp",
      "license": "MIT",
      "capabilities": [
        "scene-manipulation",
        "scripting",
        "2d-rendering",
        "3d-rendering",
        "ui",
        "audio",
        "animation",
        "physics",
        "signals",
        "runtime-input",
        "project-management"
      ]
    },
    {
      "id": "godot-live-180",
      "name": "Godot Live Control 180",
      "description": "Godot 4.7-focused MCP with project/build/export, live game control, screenshots, scene inspection and full-control operations.",
      "urlEnv": "HYOUKA_GODOT_LIVE_MCP_URL",
      "enabled": true,
      "source": "https://github.com/Fulviuus/godot-mcp",
      "capabilities": [
        "project-inspection",
        "scene-parsing",
        "script-validation",
        "build",
        "export",
        "live-run",
        "live-scene-tree",
        "live-eval",
        "hot-reload",
        "screenshots",
        "runtime-input",
        "deep-editor-control"
      ]
    },
    {
      "id": "sfxmint",
      "name": "SFXMint",
      "description": "Public MCP for searchable and hotlinkable CC0 sound effects.",
      "url": "https://sfxmint.com/mcp",
      "enabled": true,
      "source": "https://github.com/flreey/sfxmint-mcp",
      "capabilities": [
        "sound-effects",
        "foley",
        "ui-sounds",
        "search",
        "cc0-audio"
      ]
    },
    {
      "id": "sfx-gen-local",
      "name": "SFX Generator Local",
      "description": "Optional local Streamable HTTP SFX generator using Stable Audio Open for offline/local production.",
      "urlEnv": "HYOUKA_SFX_MCP_URL",
      "enabled": true,
      "source": "https://github.com/JimCline/sfx-gen-mcp",
      "license": "MIT",
      "capabilities": [
        "sound-effects",
        "foley",
        "ambience",
        "variation-generation",
        "local-audio"
      ]
    }
  ]
}
