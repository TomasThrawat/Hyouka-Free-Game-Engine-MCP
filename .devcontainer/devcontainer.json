{
  "name": "Hyouka Free DCC MCP Runtime",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [9765, 9797],
  "portsAttributes": {
    "9765": {
      "label": "Blender MCP",
      "protocol": "http",
      "onAutoForward": "notify"
    },
    "9797": {
      "label": "Krita MCP",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "DCC_MCP_BLENDER_INTERNAL_PORT": "18765",
    "DCC_MCP_BLENDER_PUBLIC_PORT": "9765",
    "DCC_MCP_KRITA_INTERNAL_PORT": "19797",
    "DCC_MCP_KRITA_PUBLIC_PORT": "9797"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "secrets": {
    "HYOUKA_DCC_MCP_TOKEN": {
      "description": "Bearer token protecting the remote Blender and Krita MCP endpoints",
      "documentationUrl": "https://docs.github.com/en/codespaces/managing-your-codespaces/managing-your-account-specific-secrets-for-github-codespaces"
    }
  },
  "postCreateCommand": "bash .devcontainer/install-dcc.sh",
  "postStartCommand": "bash .devcontainer/start-dcc.sh"
}
